# agent backend env (local `uv run` path). For Docker, the root .env is used.

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-...
AGENT_MODEL=gpt-4o-mini

# openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# Optional: Redis for production-grade proposal tokens / caching. The sample
# runs in-memory without it.
# REDIS_URL=redis://127.0.0.1:6379/0

# Durable persistence (conversations + attachment metadata). Unset = in-memory,
# gone on restart. Needs the `sql` extra: uv add "cogria-agentserv[sql]"
# AGENT_DB_URL=sqlite+aiosqlite:///./var/agent.db
# AGENT_DB_URL=postgresql+asyncpg://user:pass@127.0.0.1:5432/agent

# File uploads (images / PDF / Word). Unset = uploads disabled.
# Needs the `attachments` extra: uv add "cogria-agentserv[attachments]"
# AGENT_ATTACHMENTS_DIR=./var/attachments
# Images additionally need a vision-capable model; without this, image uploads
# are refused with a clear message (documents still work).
# AGENT_VISION_MODEL=gpt-4o-mini
