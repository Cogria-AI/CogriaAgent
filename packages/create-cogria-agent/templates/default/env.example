# Root env — used by docker-compose.yml.

# LLM (any OpenAI-compatible gateway). agentserv holds the key, not your backend.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-...
AGENT_MODEL=gpt-4o-mini

# Shared HS256 secret between the kernel and the JWT minter. Generate one:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# Pre-publish only: absolute path to your local CogriaAgent checkout, so the
# Docker image can install the (not-yet-published) framework packages.
# The scaffolder pre-filled this; clear it once the packages are on PyPI.
COGRIA_FRAMEWORK_PATH=__FRAMEWORK_PATH__
