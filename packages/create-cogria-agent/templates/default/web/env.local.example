# Front-end (CogriaAgent agent-ui) wiring for __PROJECT_NAME__.
#
# The UI is the framework's @cogria/agent-ui. Copy these into
#   <cogria-agent>/packages/agent-ui/.env.local
# then `pnpm install && pnpm dev` there. (Until agent-ui ships as a standalone
# component package in C6, you point the framework's UI at your agent this way.)

# The agent kernel this scaffold runs (uvicorn / docker compose) on :8001.
AGENTSERV_URL=http://127.0.0.1:8001

# Your /agent-auth/exchange. The scaffold mounts a DEV stub on the kernel itself;
# in production this is your real backend endpoint.
EXCHANGE_ENDPOINT=http://127.0.0.1:8001/agent-auth/exchange

# Redis for the BFF's JWT cache.
REDIS_URL=redis://127.0.0.1:6379/2
JWT_CACHE_TTL_SECONDS=1500

# Supported UI locales (comma-separated; first is the default).
SUPPORTED_LOCALES=en,zh-CN

# Branding.
NEXT_PUBLIC_APP_TITLE=__PROJECT_NAME__
NEXT_PUBLIC_APP_DESCRIPTION=A conversational agent for __PROJECT_NAME__.
