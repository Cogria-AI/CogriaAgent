# --- agent-ui (BFF + chat UI) ---

# The private agentserv the BFF forwards chat to.
AGENTSERV_URL=http://127.0.0.1:8001

# Full URL the BFF POSTs the session cookie to, to mint a short-lived JWT.
# Your business backend implements this (returns { token, expires_at }).
EXCHANGE_ENDPOINT=http://127.0.0.1:8000/agent-auth/exchange

# Redis for the BFF JWT cache.
REDIS_URL=redis://127.0.0.1:6379/2
JWT_CACHE_TTL_SECONDS=1500

# Supported UI locales (comma-separated; first is the default).
SUPPORTED_LOCALES=en,zh-CN

# Branding.
NEXT_PUBLIC_APP_TITLE=Cogria Agent
NEXT_PUBLIC_APP_DESCRIPTION=A conversational agent for your application.

# Optional: a long-running ACTION whose result yields data.image_url, for which
# the chat adapter paints a "generating…" placeholder while it runs. Empty = off.
NEXT_PUBLIC_LONG_RUNNING_IMAGE_ACTION=

# File uploads (images / PDF / Word). Set to 1 only when agentserv has the
# attachment seams wired (its /health reports "attachments": true) — this flag
# just decides whether the UI offers the paperclip.
NEXT_PUBLIC_ATTACHMENTS_ENABLED=0
# BFF-side size gate; keep at or below agentserv's attachments.max_file_bytes.
MAX_ATTACHMENT_BYTES=20971520
# Same number, visible to the browser: files upload on send, so the composer
# checks the size when the file is picked and refuses it there.
NEXT_PUBLIC_MAX_ATTACHMENT_BYTES=20971520
# File picker filter. Leave empty for the built-in list; set it to drop types
# your server won't take — notably image/* when AGENT_VISION_MODEL is unset.
# NEXT_PUBLIC_ATTACHMENTS_ACCEPT=application/pdf,.docx,.xlsx,.txt,.md,.csv
